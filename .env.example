# ==============================================================================
# AI Video Studio – Local Environment Configuration
# ==============================================================================

# Application Environment
NODE_ENV=development
API_PORT=4000
WEB_PORT=3000

# Client URLs
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_SOCKET_URL=http://localhost:4000
NEXT_PUBLIC_STORAGE_URL=http://localhost:4000/storage

# Database (Local PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_video_studio

# Redis (Local Redis Server)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Local Storage Provider (Abstracted for future S3/R2 migration)
STORAGE_DRIVER=local
LOCAL_STORAGE_PATH=./storage
MAX_UPLOAD_SIZE_MB=500
MAX_VIDEO_DURATION_SECONDS=1800

# FFmpeg & FFprobe Binary Paths (Defaults to system path or bundled fallback)
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

# JWT Authentication
JWT_SECRET=super-secret-jwt-key-for-local-ai-video-studio-development-32chars!
JWT_ACCESS_EXPIRATION=1h
JWT_REFRESH_EXPIRATION=7d

# AI Provider Configuration (Optional local mock or API key)
AI_PROVIDER=mock
OPENAI_API_KEY=
GEMINI_API_KEY=

